"""Environment setup file"""
DEBUG=True
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database
DATABASE_URL=postgresql://ibvap_user:ibvap_password@localhost:5432/ibvap_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production-123456
ALGORITHM=HS256

# Model Configuration
YOLO_MODEL_PATH=models/yolov8m.pt
YOLO_CONFIDENCE_THRESHOLD=0.5

# Detection Thresholds
HUMAN_DETECTION_THRESHOLD=0.6
VEHICLE_DETECTION_THRESHOLD=0.5
FACE_DETECTION_THRESHOLD=0.7
PLATE_DETECTION_THRESHOLD=0.65
WEAPON_DETECTION_THRESHOLD=0.85

# Night Mode
NIGHT_MODE_ENABLED=True
NIGHT_MODE_START_HOUR=18
NIGHT_MODE_END_HOUR=6

# Storage
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ibvap-storage

# GPU
GPU_ENABLED=True
MAX_WORKERS=4
